% ---------- PART A ----------
\partheading{Part A: Proper Fractions}{1}

\question
$\dfrac{3}{8} + \dfrac{2}{8} = $
\vspace*{0.5cm}
\begin{solution}
\[
\frac{3}{8} + \frac{2}{8} = \frac{3+2}{8} = \frac{5}{8}
\]
\end{solution}

\question
$\dfrac{7}{10} - \dfrac{4}{10} = $
\vspace*{0.5cm}
\begin{solution}
\[
\frac{7}{10} - \frac{4}{10} = \frac{7-4}{10} = \frac{3}{10}
\]
\end{solution}

\question
$\dfrac{13}{16} + \dfrac{5}{16} = $
\vspace*{0.5cm}
\begin{solution}
\[
\frac{13}{16} + \frac{5}{16} = \frac{13+5}{16} = \frac{18}{16} = 1\frac{2}{16} = 1\frac{1}{8}
\]
\end{solution}

\question
$\dfrac{23}{7} - \dfrac{11}{7} = $

\begin{solution}
\[
\frac{23}{7} - \frac{11}{7} = \frac{23-11}{7} = \frac{12}{7} = 1\dfrac{5}{7}
\]
\end{solution}

% ---------- PART B ----------

\partheading{Part B: Mixed Numbers}{1}
\question
$6 + \dfrac{4}{7} = $
\vspace*{1cm}
\begin{solution}
\[
6 + \frac{4}{7} = 6\frac{4}{7}
\]
\end{solution}
\question
$2\dfrac{3}{5} + 1\dfrac{1}{5} = $
\vspace*{1cm}
\begin{solution}
\[
2\frac{3}{5} + 1\frac{1}{5} = (2+1) + \left(\frac{3}{5}+\frac{1}{5}\right) = 3\frac{4}{5}
\]
\end{solution}

\question
$5\dfrac{7}{9} - 2\dfrac{4}{9} = $
\vspace*{1.3cm}
\begin{solution}
\[
5\frac{7}{9} - 2\frac{4}{9} = (5-2) + \left(\frac{7}{9}-\frac{4}{9}\right) = 3\frac{3}{9} = 3\frac{1}{3}
\]
\end{solution}

\question
$12\dfrac{7}{12} + 8\dfrac{5}{12} = $
\vspace*{1.5cm}
\begin{solution}
\[
12\frac{7}{12} + 8\frac{5}{12} = (12+8) + \left(\frac{7}{12}+\frac{5}{12}\right) = 20\frac{12}{12} = 21
\]
\end{solution}

\question
$15\dfrac{11}{14} - 6\dfrac{5}{14} = $
\vspace*{1.0cm}
\begin{solution}
\[
15\frac{11}{14} - 6\frac{5}{14} = (15-6) + \left(\frac{11}{14}-\frac{5}{14}\right) = 9\frac{6}{14} = 9\frac{3}{7}
\]
\end{solution}

% ---------- PART C ----------

\partheading{Part C: Regrouping and Simplifying}{2}
\question
$4\dfrac{1}{6} - 1\dfrac{5}{6} = $
\vspace*{1.5cm}
\begin{solution}
Since $\frac{1}{6} < \frac{5}{6}$, regroup:
\[
4\frac{1}{6} = 3 + 1 + \frac{1}{6} = 3 + \frac{6}{6} + \frac{1}{6} = 3\frac{7}{6}
\]
\[
3\frac{7}{6} - 1\frac{5}{6} = (3-1) + \left(\frac{7}{6}-\frac{5}{6}\right) = 2\frac{2}{6} = 2\frac{1}{3}
\]
\end{solution}

\question
$6\dfrac{2}{7} + 3\dfrac{5}{7} = $
\vspace*{1.5cm}
\begin{solution}
\[
6\frac{2}{7} + 3\frac{5}{7} = (6+3) + \left(\frac{2}{7}+\frac{5}{7}\right) = 9\frac{7}{7} = 10
\]
\end{solution}

\question
$18\dfrac{3}{10} - 9\dfrac{7}{10} = $
\vspace*{1.5cm}
\begin{solution}
Since $\frac{3}{10} < \frac{7}{10}$, regroup:
\[
18\frac{3}{10} = 17 + \frac{10}{10} + \frac{3}{10} = 17\frac{13}{10}
\]
\[
17\frac{13}{10} - 9\frac{7}{10} = (17-9) + \left(\frac{13}{10}-\frac{7}{10}\right) = 8\frac{6}{10} = 8\frac{3}{5}
\]
\end{solution}

\question
$25\dfrac{5}{9} + 14\dfrac{8}{9} = $
\vspace*{1.5cm}
\begin{solution}
\[
25\frac{5}{9} + 14\frac{8}{9} = (25+14) + \left(\frac{5}{9}+\frac{8}{9}\right) = 39\frac{13}{9} = 40\frac{4}{9}
\]
\end{solution}

% ---------- PART D ----------

\partheading{Part D: Multi-Step and Mixed Forms}{3}

% (a) mixed − proper (with substitution) + mixed
\question
$7\dfrac{1}{5} - \dfrac{3}{5} + 2\dfrac{1}{5} = $
\vspace*{3cm}
\begin{solution}
Since $\frac{1}{5} < \frac{3}{5}$, substitute (borrow) from the whole number:
\[
7\frac{1}{5} = 6 + \frac{5}{5} + \frac{1}{5} = 6\frac{6}{5}
\]
Subtract:
\[
6\frac{6}{5} - \frac{3}{5} = 6\frac{3}{5}
\]
Add the mixed fraction:
\[
6\frac{3}{5} + 2\frac{1}{5} = (6+2) + \left(\frac{3}{5}+\frac{1}{5}\right) = 8\frac{4}{5}
\]
So the final answer is $8\dfrac{4}{5}$.
\end{solution}

% (b) mixed - mixed + mixed - improper
\question
$9\dfrac{2}{3} - 2\dfrac{1}{3} + 1\dfrac{2}{3} - \dfrac{5}{3} = $
\vspace*{2.0cm}
\begin{solution}
Convert the improper fraction: $\frac{5}{3} = 1\frac{2}{3}$. Then evaluate left to right:
\[
9\frac{2}{3} - 2\frac{1}{3} = 7\frac{1}{3}
\]
\[
7\frac{1}{3} + 1\frac{2}{3} = 8\frac{3}{3} = 9
\]
\[
9 - \frac{5}{3} = 9 - 1\frac{2}{3} = 7\frac{1}{3}
\]
So the final answer is $7\dfrac{1}{3}$.
\end{solution}

